# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=lease
DB_PASSWORD=lease_secret
DB_NAME=lease

# MinIO 配置
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# 服务端口
CORE_PORT=8080
WEB_PORT=3000

# JWT 密钥
JWT_SECRET=lease_jwt_secret_key
ACCESS_TOKEN_TTL_SECONDS=86400
REFRESH_TOKEN_TTL_SECONDS=2592000
REFRESH_TOKEN_CLEANUP_SECONDS=3600
AGENT_GATEWAY_TOKEN=
AGENT_WORKER_ID=agent-runner-1
LLM_PRICING_VERSION=unconfigured
LLM_INPUT_PRICE_USD_PER_MILLION=0
LLM_OUTPUT_PRICE_USD_PER_MILLION=0
AGENT_CAPABILITY_SECRET=lease_agent_capability_secret
AGENT_CAPABILITY_TTL_SECONDS=300

# LLM 配置（默认使用 DeepSeek）
# 可选: deepseek / openai
LLM_PROVIDER=deepseek

# DeepSeek API Key & 模型
# 获取地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# 可用模型:
# - deepseek-v4-flash    (非思考模式，速度快，成本低)
# - deepseek-v4-pro      (思考模式，推理能力强)
# - deepseek-chat        (兼容旧版，2026/07/24 弃用)
# - deepseek-reasoner    (兼容旧版，2026/07/24 弃用)

# OpenAI API Key（备用）
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# AR3 上下文装配器（RT1-A 两级开关；L3-A 起 compose 默认 count：只计数、只上报、
# 不压缩，prompt 逐字节不变）。⚠️ 注意：非 off 模式下 ValidateModelCoverage 对
# 当前运行模型强制校验预算几何（log.Fatalf）——本地换了一个不在默认表内的模型名
# 且未配 CONTEXT_BUDGET_* 时服务会直接起不来。这是 AF1-c fail-fast 的本意提前
# 生效，不是 bug：缺哪个模型它会报哪个，补对应 CONTEXT_BUDGET_* 即可。
# 预算几何默认值：deepseek-v4-flash window=1000000 / gpt-4o window=128000，
# reserve 统一 4096；以下两项设置后覆盖所有模型。
CONTEXT_ASSEMBLER_MODE=count

# RT1-L3-C：过期租约回收 job 调度间隔（秒），默认 60。
# 系统维护型任务（不产生 run、不调工具、跨法人只重置队列/租约列，见文档索引 D39）。
AGENT_RUN_LEASE_RECOVERY_SECONDS=60
# CONTEXT_ASSEMBLER_ENABLED=false
# CONTEXT_BUDGET_WINDOW_TOKENS=
# CONTEXT_BUDGET_RESERVE_TOKENS=

# PaddleOCR（可选，证据坐标增强；未配置则降级 anydoc 文本且证据标 unavailable）
PADDLEOCR_API_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLEOCR_ACCESS_TOKEN=
PADDLEOCR_MODEL=PaddleOCR-VL-1.5
PADDLEOCR_ENABLED=false

# 日志级别
LOG_LEVEL=info

# 首个管理员引导（仅全新空库需要；凭据只从这里读取，仓库不种任何用户）
# First-admin bootstrap (only needed on a fresh empty database; credentials
# are read exclusively from these variables, the repository seeds no users)
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
