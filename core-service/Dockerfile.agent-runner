FROM golang:1.23-alpine AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /bin/agent-runner ./cmd/agent-runner

FROM alpine:latest
RUN apk --no-cache add ca-certificates
WORKDIR /root/

COPY --from=builder /bin/agent-runner .

CMD ["./agent-runner", "--worker-loop", "--planner-url", "http://ai-service:8000"]
