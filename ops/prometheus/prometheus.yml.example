global:
  scrape_interval: 30s
  evaluation_interval: 30s

rule_files:
  - /etc/prometheus/lease-agent.recording.yml
  - /etc/prometheus/lease-agent.rules.yml

scrape_configs:
  - job_name: lease-core-agent
    metrics_path: /api/v1/agent/metrics/prometheus
    static_configs:
      - targets: ["core-service:8080"]
    # The token must be provisioned as a secret outside this repository.
    # The principal needs only agent_runtime:metrics.
    bearer_token_file: /run/secrets/lease_agent_metrics_token
